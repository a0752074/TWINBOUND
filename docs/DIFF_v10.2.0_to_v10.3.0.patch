+"""Build a credential-free GitHub Pages frontend; the Python API stays separate."""
+from pathlib import Path
+import argparse
+import json
+import os
+import shutil
+from urllib.parse import urlsplit
+
+ROOT = Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser()
+parser.add_argument('--output', default=str(ROOT / 'dist'))
+parser.add_argument('--api-base', default=os.environ.get('TWINBOUND_API_BASE', ''))
+args = parser.parse_args()
+base = args.api_base.rstrip('/')
+if base:
+    parsed = urlsplit(base)
+    if parsed.scheme != 'https' or not parsed.hostname or parsed.username or parsed.password or parsed.path or parsed.query or parsed.fragment:
+        raise SystemExit('Use an HTTPS API origin without credentials, path, query or fragment.')
+target = Path(args.output).resolve()
+if target == ROOT or ROOT in target.parents and target.name != 'dist':
+    raise SystemExit('Use the project dist directory or an external output directory.')
+target.mkdir(parents=True, exist_ok=True)
+for name in ('index.html', 'LICENSE', 'assets', 'src', 'data', 'docs'):
+    source = ROOT / name
+    if source.is_dir():
+        shutil.copytree(source, target / name, dirs_exist_ok=True)
+    else:
+        shutil.copy2(source, target / name)
+(target / 'runtime-config.js').write_text('window.TWINBOUND_CONFIG=' + json.dumps({'apiBase': base}) + ';\n', encoding='utf-8')
+(target / '.nojekyll').touch()
+print('Static frontend built at', target)
+print('Shared API:', base or 'not configured; flights remain on the device until a shared API is configured')
