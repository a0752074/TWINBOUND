+            if not write and path == '/api/health':
+                return self.json_response({'status': 'ok', 'gameVersion': RULES['gameVersion'], 'scoreVersion': RULES['scoreVersion']})
+            if write:
+                data = self.body()
+                if path == '/api/players':
+                    return self.json_response(store.player(data.get('playerId')))
+                if path == '/api/flights':
