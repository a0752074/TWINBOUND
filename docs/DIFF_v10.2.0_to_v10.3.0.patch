+                    v = int(query.get(name, [str(default)])[0])
+                except ValueError:
+                    raise APIError('Invalid pagination.') from None
+                if v < (1 if name == 'limit' else 0) or v > maximum:
+                    raise APIError('Invalid pagination.')
+                return v
