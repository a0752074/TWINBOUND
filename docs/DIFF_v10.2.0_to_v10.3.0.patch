+        except ValueError:
+            self.send_error(403)
+
+    def do_POST(self):
+        if not urlsplit(self.path).path.startswith('/api/'):
+            return self.json_response({'error': 'Unknown endpoint.'}, 404)
+        self.api(write=True)
