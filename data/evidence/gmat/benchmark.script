% TWINBOUND matched two-body benchmark. Status: Not Executed.
Create Spacecraft Probe;
GMAT Probe.DateFormat = 'TAIModJulian';
GMAT Probe.Epoch = '21545';
GMAT Probe.CoordinateSystem = EarthMJ2000Eq;
GMAT Probe.DisplayStateType = Cartesian;
GMAT Probe.X = 7000;
GMAT Probe.Y = 0;
GMAT Probe.Z = 0;
GMAT Probe.VX = 0;
GMAT Probe.VY = 7.5;
GMAT Probe.VZ = 1;
GMAT Earth.Mu = 398600.43550702266;
Create ForceModel BenchmarkForce;
GMAT BenchmarkForce.CentralBody = Earth;
GMAT BenchmarkForce.PrimaryBodies = {};
GMAT BenchmarkForce.PointMasses = {Earth};
GMAT BenchmarkForce.Drag = None;
GMAT BenchmarkForce.SRP = Off;
GMAT BenchmarkForce.RelativisticCorrection = Off;
Create Propagator BenchmarkProp;
GMAT BenchmarkProp.FM = BenchmarkForce;
GMAT BenchmarkProp.Type = PrinceDormand78;
GMAT BenchmarkProp.InitialStepSize = 1;
GMAT BenchmarkProp.Accuracy = 1e-12;
GMAT BenchmarkProp.MinStep = 0.001;
GMAT BenchmarkProp.MaxStep = 30;
Create ReportFile OrbitReport;
GMAT OrbitReport.Filename = 'gmat_raw.csv';
GMAT OrbitReport.Precision = 16;
GMAT OrbitReport.WriteHeaders = true;
GMAT OrbitReport.FixedWidth = false;
GMAT OrbitReport.Delimiter = ',';
Create Variable targetTime;
BeginMissionSequence;
Report OrbitReport Probe.ElapsedSecs Probe.EarthMJ2000Eq.X Probe.EarthMJ2000Eq.Y Probe.EarthMJ2000Eq.Z Probe.EarthMJ2000Eq.VX Probe.EarthMJ2000Eq.VY Probe.EarthMJ2000Eq.VZ;
For targetTime = 60:60:3600;
  Propagate BenchmarkProp(Probe) {Probe.ElapsedSecs = targetTime};
  Report OrbitReport Probe.ElapsedSecs Probe.EarthMJ2000Eq.X Probe.EarthMJ2000Eq.Y Probe.EarthMJ2000Eq.Z Probe.EarthMJ2000Eq.VX Probe.EarthMJ2000Eq.VY Probe.EarthMJ2000Eq.VZ;
EndFor;
